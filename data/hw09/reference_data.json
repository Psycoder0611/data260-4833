 "topics": {
  "field_limits": {
   "failure_pattern": "The answer gives a wrong or missing length limit for a field of a trial listing.",
   "instruction": "Field length limits of a trial listing are fixed by the platform. Use these exact values:"
  },
  "creation_rules": {
   "failure_pattern": "The answer does not state the platform's rule for creating a trial listing.",
   "instruction": "Use these exact creation rules:"
  },
  "message_handling": {
   "failure_pattern": "The answer does not state how the platform's agents retry, commit and dead-letter messages.",
   "instruction": "Use these exact message-handling rules:"
  },
  "trial_records": {
   "failure_pattern": "The answer does not give the capacity or title that is stored for a trial.",
   "instruction": "Use these exact stored values for trials:"
  },
  "unavailable_data": {
   "failure_pattern": "The answer invents a value that the listings data does not contain.",
   "instruction": "The listings data does not hold every detail of a trial. If a value that was asked for is not part of the listing (phase, principal investigator, start date, enrollment deadline, number enrolled so far), say clearly that it is not available instead of guessing."
  }
 },
